---
import "../styles/global.css"
import { SECTIONS, bySection, noteUrl } from "../lib/notes"
import { SITE } from "../lib/site"
import Palette from "../components/Palette.astro"
interface Props {
  title: string
  description?: string
  active?: string
  wide?: boolean
  image?: string // og image path, defaults to the site card
  imageAlt?: string
  type?: "website" | "article" | "profile"
  published?: Date
  tags?: string[]
  lang?: string
  jsonLd?: Record<string, unknown>[]
  alternates?: { lang: string; href: string }[]
}
const { title, description = SITE.description, active = "", wide = false, image = "/og/index.png", imageAlt, type = "website", published, tags = [], lang = "en", jsonLd = [], alternates = [] } = Astro.props
const topics = await bySection("Topics")
const full = title === "MetaVault" ? `${SITE.author} — ${SITE.tagline}` : `${title} · MetaVault`
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(image, Astro.site).href
const person = { "@type": "Person", "@id": `${SITE.url}/#person`, name: SITE.author, url: SITE.url, image: `${SITE.url}/icon.png`, jobTitle: "Game developer and software engineer", knowsAbout: SITE.knowsAbout, sameAs: SITE.sameAs }
const graph = [
  { "@type": "WebSite", "@id": `${SITE.url}/#website`, url: SITE.url, name: SITE.name, description: SITE.description, inLanguage: ["en", "uk"], publisher: { "@id": `${SITE.url}/#person` }, potentialAction: { "@type": "SearchAction", target: `${SITE.url}/?q={search_term_string}`, "query-input": "required name=search_term_string" } },
  person,
  ...jsonLd,
]
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title === "MetaVault" ? full : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "uk" ? "uk_UA" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && <meta property="article:author" content={SITE.url} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={title === "MetaVault" ? full : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
    <script is:inline defer data-domain="dmytrogladkyi.com" src="https://plausible.io/js/script.js"></script>
    <script is:inline>
      // Apply before the body paints to avoid a white flash on dark pages.
      (() => {
        let theme = new URLSearchParams(location.search).get("theme")
        if (theme !== "light" && theme !== "dark") {
          try { theme = localStorage.getItem("theme") } catch {}
        }
        const preference = theme === "dark" || theme === "light" ? theme : "auto"
        const resolved = preference === "auto" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : preference
        document.documentElement.dataset.themePreference = preference
        document.documentElement.dataset.theme = resolved
        document.querySelector('meta[name="theme-color"]').content = resolved === "dark" ? "#202224" : "#ffffff"
      })()
      try { const l = new URLSearchParams(location.search).get("lang") ?? localStorage.getItem("langFilter"); if (l === "en" || l === "uk") document.documentElement.dataset.langFilter = l } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="masthead"><a href="/">Dmytro Gladkyi’s MetaVault</a><span>Notes, projects &amp; ideas</span></header>
    <div class:list={["site-layout", { "site-layout-wide": wide }]}>
      <aside class="navigation" aria-label="Site navigation">
        <details class="mobile-menu" open>
          <summary>Menu &amp; catalogs</summary>
          <div class="navigation-inner">
        <nav aria-label="Menu">
          <h2>Menu</h2>
          <ul>{SECTIONS.map((s) => <li><a href={s.href} aria-current={active === s.id ? "page" : undefined}>{s.label}</a></li>)}</ul>
        </nav>
        <nav aria-label="Catalogs">
          <h2>Catalogs</h2>
          <ul>
            <li><a href="/GladRoTools/">GladRoTools</a></li>
            {topics.map((n) => <li><a href={noteUrl(n.id)}>{n.data.title}</a></li>)}
          </ul>
        </nav>
        <section><h2>Search</h2><button id="open-search">Search the vault</button><small>Ctrl K or /</small><noscript>Browse the catalogs or <a href="/tags/">tags</a> without JavaScript.</noscript></section>
        <section><h2>Language</h2>
          <div class="langsw" role="group" aria-label="Filter posts by language">
            <button data-l="">All</button><button data-l="en">EN</button><button data-l="uk">UA</button>
          </div>
        </section>
        <section><h2>Theme</h2>
          <button type="button" id="theme-toggle" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark theme">
            <span>White</span><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span>Dark</span>
          </button>
          <button type="button" id="theme-auto" class="theme-auto" aria-pressed="true">Use browser setting</button>
        </section>
        <nav aria-label="Elsewhere"><h2>Elsewhere</h2><ul>
          <li><a href="https://github.com/gladimdim">GitHub</a></li>
          <li><a href="https://t.me/locadesertachumaki">Telegram</a></li>
          <li><a href="https://gladimdim.github.io/LocaDesertaSciFi">Loca Deserta Sci-Fi</a></li>
          <li><a href="https://apps.apple.com/us/app/gladrotools/id6765629252">Mac App Store</a></li>
          <li><a href="/index.xml">RSS feed</a></li>
        </ul></nav>
          </div>
        </details>
        <script is:inline>
          (() => {
            const menu = document.querySelector(".mobile-menu")
            const phone = matchMedia("(max-width: 760px)")
            const updateMenu = () => { menu.open = !phone.matches }
            updateMenu()
            phone.addEventListener("change", updateMenu)
          })()
        </script>
      </aside>
      <main id="content" tabindex="-1"><slot /></main>
      {!wide && <aside class="context" aria-label="Page information">
        <slot name="sidebar"><section><h2>About this vault</h2><p>Notes on games, software and writing, by Dmytro Gladkyi.</p><p>Follow links between notes or browse the <a href="/tags/">tag index</a>.</p></section></slot>
      </aside>}
    </div>
    <footer class="foot">© Dmytro Gladkyi · <a href="/">Home</a> · <a href="/index.xml">RSS</a></footer>
    <Palette />
    <script is:inline>
      const langBtns = document.querySelectorAll(".langsw button")
      const markLang = () => langBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.l === (document.documentElement.dataset.langFilter ?? ""))))
      langBtns.forEach((b) => (b.onclick = () => {
        const r = document.documentElement
        const l = b.dataset.l === r.dataset.langFilter ? "" : b.dataset.l // clicking the active one clears it
        if (l) r.dataset.langFilter = l
        else delete r.dataset.langFilter
        try { localStorage.setItem("langFilter", l) } catch {}
        markLang()
        dispatchEvent(new Event("langfilter"))
      }))
      markLang()
      const themeToggle = document.getElementById("theme-toggle")
      const themeAuto = document.getElementById("theme-auto")
      const browserTheme = matchMedia("(prefers-color-scheme: dark)")
      const applyTheme = () => {
        const root = document.documentElement
        const automatic = root.dataset.themePreference === "auto"
        const theme = automatic ? (browserTheme.matches ? "dark" : "light") : root.dataset.themePreference
        root.dataset.theme = theme
        document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#202224" : "#ffffff"
        themeToggle.setAttribute("aria-checked", String(theme === "dark"))
        themeAuto.setAttribute("aria-pressed", String(automatic))
      }
      const chooseTheme = (preference) => {
        document.documentElement.dataset.themePreference = preference
        try {
          if (preference === "auto") localStorage.removeItem("theme")
          else localStorage.setItem("theme", preference)
        } catch {}
        // A preview query must not override an explicit choice on reload.
        const url = new URL(location.href)
        if (url.searchParams.has("theme")) {
          url.searchParams.delete("theme")
          history.replaceState(null, "", url)
        }
        applyTheme()
      }
      themeToggle.addEventListener("click", () => chooseTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark"))
      themeAuto.addEventListener("click", () => chooseTheme("auto"))
      browserTheme.addEventListener("change", applyTheme)
      applyTheme()
    </script>
  </body>
</html>
