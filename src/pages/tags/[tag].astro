---
import Base from "../../layouts/Base.astro"
import Card from "../../components/Card.astro"
import { tagIndex } from "../../lib/notes"
export async function getStaticPaths() {
  const all = await tagIndex()
  return all.map(([tag, value]) => ({ params: { tag }, props: { ...value, others: all.slice(0, 24) } }))
}
const { label, notes, others } = Astro.props
const { tag } = Astro.params
---
<Base title={`#${label} — articles and notes`} active="tags" image={`/og/tags/${tag}.png`}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/tags/">Tags</a></nav>
  <h1>Tagged: {label}</h1>
  <div class="note-list">{notes.map((note) => <Card note={note} />)}</div>
  <section slot="sidebar"><h2>Other tags</h2><ul>{others.filter(([k]) => k !== tag).map(([k, v]) => <li><a href={`/tags/${k}/`}>{v.label}</a></li>)}</ul><a href="/tags/">All tags →</a></section>
</Base>
