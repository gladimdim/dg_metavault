---
import Base from "../../layouts/Base.astro"
import Win from "../../components/Win.astro"
import Card from "../../components/Card.astro"
import { tagIndex } from "../../lib/notes"
export async function getStaticPaths() {
  const all = await tagIndex()
  return all.map(([k, v]) => ({ params: { tag: k }, props: { label: v.label, notes: v.notes, others: all.slice(0, 24) } }))
}
const { label, notes, others } = Astro.props
const { tag } = Astro.params
---
<Base title={`#${label}`} active="tags">
  <div class="wrap">
    <Win n="1" path={`~/tags/<em>${label}</em>`} hint={`${notes.length} notes`} class="fade-in active">
      <div class="body">
        <p class="mono kick">❯ grep -rl "#{label}" ~/vault</p>
        <h1><span>#</span>{label}</h1>
        <div class="tags">
          {others.map(([k, v]) => <a href={`/tags/${k}/`} class:list={["tag", { on: k === tag }]}>{v.label}<sup>{v.notes.length}</sup></a>)}
          <a href="/tags/" class="tag">…all</a>
        </div>
      </div>
    </Win>
    <Win n="2" path={`results <em>(${notes.length})</em>`} class="fade-in">
      <div class="body"><div class="cards">{notes.map((n) => <Card note={n} />)}</div></div>
    </Win>
  </div>
</Base>
<style>
  .wrap { display: grid; gap: 12px; max-width: 1280px; margin: 0 auto; }
  .kick { margin: 0 0 8px; font-size: 12.5px; color: var(--muted); }
  h1 { font: 800 clamp(40px, 6vw, 72px)/1 "Inter"; letter-spacing: -.04em; margin: 0 0 20px; }
  h1 span { color: var(--c3); }
</style>
