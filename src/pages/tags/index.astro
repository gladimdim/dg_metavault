---
import Base from "../../layouts/Base.astro"
import { tagIndex } from "../../lib/notes"
const tags = (await tagIndex()).sort((a, b) => a[1].label.localeCompare(b[1].label))
---
<Base title="Tags" active="tags" image="/og/tags.png">
  <h1>Tags</h1><p>Browse the vault by subject.</p>
  <ul class="tag-index">{tags.map(([slug, tag]) => <li><a href={`/tags/${slug}/`}>{tag.label}</a></li>)}</ul>
</Base>
