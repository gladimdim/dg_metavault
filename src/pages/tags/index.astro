---
import Base from "../../layouts/Base.astro"
import Win from "../../components/Win.astro"
import { tagIndex } from "../../lib/notes"
const tags = await tagIndex()
const max = tags[0][1].notes.length
---
<Base title="Tags" active="tags">
  <div class="wrap">
    <Win n="1" path="~/<em>tags</em> — sort | uniq -c | sort -rn" hint={`${tags.length} tags`} class="fade-in active">
      <div class="body">
        <h1>Tags</h1>
        <div class="cloud">
          {tags.map(([k, v]) => {
            const w = v.notes.length / max
            return <a class="tag" href={`/tags/${k}/`} style={`font-size:${12 + w * 16}px;padding:${5 + w * 5}px ${8 + w * 6}px`}>{v.label}<sup>{v.notes.length}</sup></a>
          })}
        </div>
      </div>
    </Win>
    <Win n="2" path="<em>histogram</em>" class="fade-in">
      <ul class="mono hist">
        {tags.slice(0, 20).map(([k, v]) => (
          <li><a href={`/tags/${k}/`}><span class="l">{v.label}</span><span class="b"><i style={`width:${(v.notes.length / max) * 100}%`}></i></span><span class="c">{v.notes.length}</span></a></li>
        ))}
      </ul>
    </Win>
  </div>
</Base>
<style>
  .wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; max-width: 1280px; margin: 0 auto; align-items: start; }
  h1 { font: 800 48px/1 "Inter"; letter-spacing: -.04em; margin: 4px 0 22px; }
  .cloud { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .hist { list-style: none; margin: 0; padding: 12px; font-size: 12.5px; }
  .hist a { display: grid; grid-template-columns: 110px 1fr 28px; gap: 10px; align-items: center; padding: 5px 6px; text-decoration: none; border-radius: 4px; }
  .hist a:hover { background: var(--panel-2); }
  .hist .l { color: var(--c3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hist .b { height: 10px; background: var(--panel-2); border-radius: 2px; overflow: hidden; }
  .hist i { display: block; height: 100%; background: linear-gradient(90deg, var(--c1), var(--c2)); }
  .hist .c { text-align: right; color: var(--muted); }
  @media (max-width: 900px) { .wrap { grid-template-columns: 1fr; } }
</style>
