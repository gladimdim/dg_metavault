---
import Base from "../layouts/Base.astro"
import Card from "../components/Card.astro"
import { bySection, tagIndex } from "../lib/notes"
const articles = await bySection("Articles")
const micro = await bySection("Micro")
const tags = await tagIndex()
---
<Base title="MetaVault">
  <h1>Welcome to MetaVault</h1>
  <p>I’m Dmytro Gladkyi. This is my notebook on making games, building software, and writing science fiction.</p>
  <p>Browse a catalog on the left, or start with a recent note below.</p>
  <h2>Latest articles</h2>
  <div class="note-list">{articles.slice(0, 18).map((note) => <Card note={note} />)}</div>
  <p><a href="/Articles/">Browse all articles →</a></p>
  <h2>Micro notes</h2>
  <div class="note-list">{micro.slice(0, 6).map((note) => <Card note={note} />)}</div>
  <p><a href="/Micro/">Browse all micro notes →</a></p>
  <Fragment slot="sidebar">
    <section><h2>Browse by tag</h2><ul>{tags.slice(0, 20).map(([slug, tag]) => <li><a href={`/tags/${slug}/`}>{tag.label}</a></li>)}</ul><a href="/tags/">All tags →</a></section>
    <section><h2>Projects &amp; writing</h2><ul>
      <li><a href="/Omarchy/">Omarchy projects</a></li>
      <li><a href="/GladRoTools/">GladRoTools documentation</a></li>
      <li><a href="https://gladimdim.github.io/LocaDesertaSciFi">Loca Deserta Sci-Fi</a></li>
    </ul></section>
  </Fragment>
</Base>
