---
import { games } from "../data/games"
---
<section class="games-feature" aria-labelledby="games-feature-title">
  <div class="games-copy">
    <div class="games-heading">
      <p class="eyebrow">Made in Ukraine · Since 2019</p>
      <h2 id="games-feature-title">Small beginnings.<br />Entire worlds.</h2>
    </div>
    <div class="games-details">
      <p>Stories you can step into. Settlements you can build. A world worth defending. Explore the games I’ve made, one chapter at a time.</p>
      <div class="feature-footer"><a href="/games/">Explore my games <span aria-hidden="true">↗</span></a><span>{games.length} games · a growing universe</span></div>
    </div>
  </div>
  <div class="game-strip" aria-label="A glimpse of the games">
    {[
      { id: "sicha", label: "SICHA", detail: "Cross sabres" },
      { id: "valka", label: "Valka", detail: "Follow the salt road" },
      { id: "settlers", label: "Settlers", detail: "Reach the stars" },
    ].map((game) => <a href={`/games/#${game.id}`}><img src={`/images/games/${game.id}.webp`} alt="" width="560" height="315" loading="lazy" /><span><strong>{game.label}</strong><small>{game.detail} ↗</small></span></a>)}
  </div>
</section>
<style>
  .games-feature { margin: 30px 0; border: 1px solid var(--line-2); background: var(--panel-2); container-type: inline-size; }
  .games-copy { display: grid; grid-template-columns: 1fr 1.25fr; align-items: center; gap: 28px; padding: 24px 28px; }
  .games-copy > div { min-width: 0; }
  .eyebrow { text-transform: uppercase; font: 11px/1.5 Verdana, sans-serif; letter-spacing: .14em; color: var(--dim); margin: 0 0 12px; }
  h2 { font: normal clamp(32px, 3vw, 42px)/1.08 Georgia, serif; letter-spacing: -.035em; margin: 0; color: var(--heading); }
  .games-details > p { color: var(--dim); margin: 0 0 16px; }
  .feature-footer { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .feature-footer > a, .feature-footer > a:visited { display: inline-flex; gap: 24px; padding: 12px 16px; background: var(--heading); color: var(--bg); font: bold 12px/1.5 Verdana, sans-serif; text-decoration: none; }
  .feature-footer > a:hover { background: var(--c1); }
  .feature-footer > span { color: var(--muted); font: 11px/1.5 Verdana, sans-serif; }
  .game-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border-top: 1px solid var(--line); }
  .game-strip a { background: var(--panel); text-decoration: none; color: var(--text); }
  .game-strip img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
  .game-strip a > span { display: block; padding: 12px; }
  .game-strip strong { display: block; font-size: 18px; }
  .game-strip small { display: block; margin-top: 4px; font: 10px/1.5 Verdana, sans-serif; color: var(--muted); }
  .game-strip a:hover strong { color: var(--hover); }
  @container (max-width: 620px) {
    .games-copy { grid-template-columns: 1fr; gap: 18px; padding: 22px; }
    h2 { font-size: 32px; }
  }
  @media (max-width: 420px) { .game-strip a > span { padding: 10px 8px; } .game-strip small { font-size: 9px; } }
</style>
