<dialog id="palette" class="pal" aria-label="Search the vault">
  <div class="pal-in">
    <div class="pal-q"><label for="pal-input">Search</label><input id="pal-input" placeholder="search notes, tags, sections…" autocomplete="off" spellcheck="false" /><button type="button" onclick="document.getElementById('palette').close()" aria-label="Close search">Close</button></div>
    <ul id="pal-res"></ul>
    <div class="pal-foot mono"><span>↑↓ navigate</span><span>↵ open</span><span>#tag to filter</span></div>
  </div>
</dialog>

<style is:global>
  .pal { width: min(720px, calc(100vw - 24px)); padding: 0; border: 1px solid var(--line-2); background: var(--panel); color: var(--text); margin: 10vh auto; }
  .pal::backdrop { background: #0006; }
  .pal-q { display: flex; gap: 10px; padding: 14px; border-bottom: 1px solid var(--line); }
  .pal-q input { min-width: 0; flex: 1; padding: 6px; font-size: 16px; }
  #pal-res { list-style: none; margin: 0; padding: 8px; max-height: 55vh; overflow: auto; }
  #pal-res li a { display: block; padding: 10px; overflow-wrap: anywhere; }
  #pal-res .s, #pal-res .d { font-size: 12px; color: var(--muted); margin-right: 10px; }
  #pal-res .t small { display: block; color: var(--dim); }
  #pal-res li.sel { background: var(--selected); }
  .pal-foot { padding: 10px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 16px; font-size: 12px; }
  @media (max-width: 760px) {
    .pal { margin: 12px auto; max-height: calc(100dvh - 24px); overflow-y: auto; }
    .pal-q { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 10px; }
    .pal-q label { grid-column: 1 / -1; }
    .pal-q input, .pal-q button { min-height: 44px; }
    #pal-res { max-height: 50dvh; }
  }
</style>

<script is:inline>
  (() => {
    const dlg = document.getElementById("palette"), input = document.getElementById("pal-input"), res = document.getElementById("pal-res")
    let data = null, sel = 0, items = []
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]))
    const hl = (s, qs) => { let h = esc(s); for (const q of qs) if (q) h = h.replace(new RegExp("(" + q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "ig"), "<mark>$1</mark>"); return h }
    async function open() {
      dlg.showModal(); input.value = ""; input.focus()
      if (!data) data = await (await fetch("/search.json")).json()
      render()
    }
    function render() {
      const raw = input.value.trim().toLowerCase()
      const tagQ = [...raw.matchAll(/#(\S+)/g)].map((m) => m[1])
      const qs = raw.replace(/#\S+/g, "").split(/\s+/).filter(Boolean)
      items = data
        .filter((d) => tagQ.every((t) => d.g.some((g) => g.startsWith(t))))
        .map((d) => {
          const tl = d.t.toLowerCase(), xl = d.x.toLowerCase()
          let s = 0
          for (const q of qs) {
            if (tl.includes(q)) s += tl.startsWith(q) ? 6 : 4
            else if (d.g.some((g) => g.includes(q))) s += 3
            else if (xl.includes(q)) s += 1
            else return null
          }
          return { d, s: s + (d.s === "Articles" ? 0.5 : 0) }
        })
        .filter(Boolean)
        .sort((a, b) => b.s - a.s || b.d.d.localeCompare(a.d.d))
        .slice(0, 40)
        .map((x) => x.d)
      sel = 0
      res.innerHTML = items.length
        ? items.map((d, i) => {
            let snip = ""
            if (qs[0]) { const at = d.x.toLowerCase().indexOf(qs[0]); if (at >= 0) snip = (at > 30 ? "…" : "") + d.x.slice(Math.max(0, at - 30), at + 90) }
            return `<li class="${i === 0 ? "sel" : ""}"><a href="${d.u}"><span class="s">${esc(d.s)}</span><span class="t">${hl(d.t, qs)}<small>${hl(snip || d.g.map((g) => "#" + g).join(" "), qs)}</small></span><span class="d">${d.d}</span></a></li>`
          }).join("")
        : `<li class="empty">no matches. try #flutter or "fog"</li>`
    }
    function move(k) {
      const lis = res.querySelectorAll("li"); if (!items.length) return
      lis[sel]?.classList.remove("sel"); sel = (sel + k + items.length) % items.length
      lis[sel].classList.add("sel"); lis[sel].scrollIntoView({ block: "nearest" })
    }
    input.addEventListener("input", render)
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); move(1) }
      if (e.key === "ArrowUp") { e.preventDefault(); move(-1) }
      if (e.key === "Enter" && items[sel]) location.href = items[sel].u
    })
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close() })
    document.getElementById("open-search").onclick = open
    document.addEventListener("keydown", (e) => {
      const typing = /INPUT|TEXTAREA/.test(document.activeElement?.tagName || "")
      if ((e.key === "k" && (e.ctrlKey || e.metaKey)) || (e.key === "/" && !typing)) { e.preventDefault(); dlg.open ? dlg.close() : open() }
    })
    window.openPalette = (q) => { open().then(() => { input.value = q; render() }) }
    const q0 = new URLSearchParams(location.search).get("q")
    if (q0 !== null) openPalette(q0)
  })()
</script>
