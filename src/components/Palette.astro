<dialog id="palette" class="pal">
  <div class="pal-in">
    <div class="pal-q"><span class="mono">❯</span><input id="pal-input" placeholder="search notes, tags, sections…" autocomplete="off" spellcheck="false" /><kbd>esc</kbd></div>
    <ul id="pal-res"></ul>
    <div class="pal-foot mono"><span>↑↓ navigate</span><span>↵ open</span><span>#tag to filter</span></div>
  </div>
</dialog>

<style is:global>
  .pal { border: 0; padding: 0; background: transparent; width: min(720px, calc(100vw - 24px)); margin: 12vh auto auto; color: var(--text); }
  .pal::backdrop { background: rgba(3, 5, 9, .55); backdrop-filter: blur(4px); }
  .pal-in { background: var(--panel-2); border-radius: 12px; border: 2px solid transparent;
    background: linear-gradient(var(--panel-2), var(--panel-2)) padding-box, linear-gradient(45deg, var(--c1), var(--c2)) border-box;
    box-shadow: 0 30px 80px -20px rgba(0,0,0,.7), 0 0 40px -10px var(--c1); overflow: hidden; }
  .pal-q { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .pal-q span { color: var(--c2); font-size: 18px; }
  .pal-q input { flex: 1; background: none; border: 0; outline: 0; color: var(--text); font: 500 17px "JetBrains Mono", monospace; }
  .pal-q kbd { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 2px 6px; }
  #pal-res { list-style: none; margin: 0; padding: 6px; max-height: 52vh; overflow-y: auto; }
  #pal-res li a { display: grid; grid-template-columns: 92px 1fr auto; gap: 12px; align-items: baseline; padding: 9px 12px; border-radius: 7px; text-decoration: none; }
  #pal-res li .s { font: 600 11px "JetBrains Mono", monospace; color: var(--c5); text-transform: lowercase; }
  #pal-res li .t { font-weight: 600; }
  #pal-res li .t small { display: block; font-weight: 400; color: var(--muted); font-size: 13px; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 470px; }
  #pal-res li .d { font: 11px "JetBrains Mono", monospace; color: var(--muted); }
  #pal-res li.sel a { background: color-mix(in srgb, var(--c1) 14%, transparent); box-shadow: inset 2px 0 0 var(--c2); }
  #pal-res mark { background: none; color: var(--c3); }
  #pal-res .empty { padding: 20px; color: var(--muted); font-family: "JetBrains Mono", monospace; }
  .pal-foot { display: flex; gap: 18px; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); }
  @media (max-width: 760px) { #pal-res li a { grid-template-columns: 1fr; gap: 2px; } #pal-res li .t small { max-width: 80vw; } }
</style>

<script is:inline>
  (() => {
    const dlg = document.getElementById("palette"), input = document.getElementById("pal-input"), res = document.getElementById("pal-res")
    let data = null, sel = 0, items = []
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]))
    const hl = (s, qs) => { let h = esc(s); for (const q of qs) if (q) h = h.replace(new RegExp("(" + q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "ig"), "<mark>$1</mark>"); return h }
    async function open() {
      dlg.showModal(); input.value = ""; input.focus()
      if (!data) data = await (await fetch("/search.json")).json()
      render()
    }
    function render() {
      const raw = input.value.trim().toLowerCase()
      const tagQ = [...raw.matchAll(/#(\S+)/g)].map((m) => m[1])
      const qs = raw.replace(/#\S+/g, "").split(/\s+/).filter(Boolean)
      items = data
        .filter((d) => tagQ.every((t) => d.g.some((g) => g.startsWith(t))))
        .map((d) => {
          const tl = d.t.toLowerCase(), xl = d.x.toLowerCase()
          let s = 0
          for (const q of qs) {
            if (tl.includes(q)) s += tl.startsWith(q) ? 6 : 4
            else if (d.g.some((g) => g.includes(q))) s += 3
            else if (xl.includes(q)) s += 1
            else return null
          }
          return { d, s: s + (d.s === "Articles" ? 0.5 : 0) }
        })
        .filter(Boolean)
        .sort((a, b) => b.s - a.s || b.d.d.localeCompare(a.d.d))
        .slice(0, 40)
        .map((x) => x.d)
      sel = 0
      res.innerHTML = items.length
        ? items.map((d, i) => {
            let snip = ""
            if (qs[0]) { const at = d.x.toLowerCase().indexOf(qs[0]); if (at >= 0) snip = (at > 30 ? "…" : "") + d.x.slice(Math.max(0, at - 30), at + 90) }
            return `<li class="${i === 0 ? "sel" : ""}"><a href="${d.u}"><span class="s">${esc(d.s)}</span><span class="t">${hl(d.t, qs)}<small>${hl(snip || d.g.map((g) => "#" + g).join(" "), qs)}</small></span><span class="d">${d.d}</span></a></li>`
          }).join("")
        : `<li class="empty">no matches. try #flutter or "fog"</li>`
    }
    function move(k) {
      const lis = res.querySelectorAll("li"); if (!items.length) return
      lis[sel]?.classList.remove("sel"); sel = (sel + k + items.length) % items.length
      lis[sel].classList.add("sel"); lis[sel].scrollIntoView({ block: "nearest" })
    }
    input.addEventListener("input", render)
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); move(1) }
      if (e.key === "ArrowUp") { e.preventDefault(); move(-1) }
      if (e.key === "Enter" && items[sel]) location.href = items[sel].u
    })
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close() })
    document.getElementById("open-search").onclick = open
    document.addEventListener("keydown", (e) => {
      const typing = /INPUT|TEXTAREA/.test(document.activeElement?.tagName || "")
      if ((e.key === "k" && (e.ctrlKey || e.metaKey)) || (e.key === "/" && !typing)) { e.preventDefault(); dlg.open ? dlg.close() : open() }
    })
    window.openPalette = (q) => { open().then(() => { input.value = q; render() }) }
    const q0 = new URLSearchParams(location.search).get("q")
    if (q0 !== null) openPalette(q0)
  })()
</script>
