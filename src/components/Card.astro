---
import { imageOf, noteUrl, fmtDate, visibleTags, tagSlug, langOf, isTranslation, type Note } from "../lib/notes"
interface Props { note: Note; hidden?: boolean }
const { note, hidden } = Astro.props
const img = imageOf(note)
const tags = visibleTags(note)
const palette = [["#33ccff", "#a78bfa"], ["#00ff99", "#33ccff"], ["#ffd23f", "#ff4f8b"], ["#a78bfa", "#ff4f8b"], ["#ff4f8b", "#ffd23f"], ["#00ff99", "#ffd23f"]]
const h = [...note.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7)
const [g1, g2] = palette[h % palette.length]
const glyph = (tags[0] || note.data.section || "?").slice(0, 2)
const lang = langOf(note)
const isUa = lang === "uk"
---
<a class="card" href={noteUrl(note.id)} data-lang={lang} data-tr={isTranslation(note) ? "1" : undefined} data-tags={tags.map(tagSlug).join(" ")} hidden={hidden}>
  {img
    ? <div class="img" style={`background-image:url("${img}")`}>{isUa && <span class="lang">🇺🇦</span>}</div>
    : <div class="img gen" style={`--g1:${g1};--g2:${g2}`}>{glyph}{isUa && <span class="lang">🇺🇦</span>}</div>}
  <div class="meta">
    <span class="d">{fmtDate(note.data.date)}</span>
    <h3>{note.data.title}</h3>
    {note.data.description && <p>{note.data.description}</p>}
    <div class="tags">{tags.slice(0, 3).map((t) => <span class="tag">{t.toLowerCase()}</span>)}</div>
  </div>
</a>
