---
import { noteUrl, fmtDate, langOf, isTranslation, type Note } from "../lib/notes"
interface Props { note: Note; hidden?: boolean }
const { note, hidden } = Astro.props
---
<article class="note-entry" data-lang={langOf(note)} data-tr={isTranslation(note) ? "1" : undefined} hidden={hidden}>
  <h3><a href={noteUrl(note.id)}>{note.data.title}</a></h3>
  {note.data.date && <time datetime={note.data.date.toISOString()}>{fmtDate(note.data.date)}</time>}
  {note.data.description && <p>{note.data.description}</p>}
</article>
